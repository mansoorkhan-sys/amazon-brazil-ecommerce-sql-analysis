--  8 Find the top 5 product categories by total revenue
SELECT 
    COALESCE(p.product_category_name, 'Unknown') AS category,
    ROUND(SUM(oi.price), 2) total_revenue
FROM
    products p
        JOIN
    order_items oi USING (product_id)
GROUP BY (category)
ORDER BY total_revenue DESC
LIMIT 5;


-- 9. Find the median delivery time (in days) between order placement and actual delivery. 
WITH cte AS (
    SELECT
        order_id,
        TIMESTAMPDIFF(
            DAY,
            order_purchase_timestamp,
            order_delivered_customer_date
        ) AS delivery_days
    FROM orders
    WHERE order_status = 'delivered'
      AND order_delivered_customer_date IS NOT NULL
),
cte2 AS (
    SELECT
        order_id,
        delivery_days,
        ROW_NUMBER() OVER(
            ORDER BY delivery_days
        ) AS rn,
        COUNT(*) OVER() AS total_orders
    FROM cte
)
SELECT
    AVG(delivery_days) AS median_delivery_days
FROM cte2
WHERE rn IN (
    FLOOR((total_orders + 1) / 2),
    FLOOR((total_orders + 2) / 2)
);
    
