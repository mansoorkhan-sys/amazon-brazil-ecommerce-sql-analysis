-- Amazon project

-- 1. Find the total number of orders fulfilled by each seller state.
create temporary table delivered_order
(SELECT 
    oi.order_id, oi.seller_id, o.order_status
FROM
    order_items oi
        JOIN
    orders o USING (order_id)
WHERE
    o.order_status = 'delivered');
SELECT 
    *
FROM
    delivered_order;
SELECT 
    s.seller_state, COUNT(d.order_id) fulfilled_orders
FROM
    sellers s
        JOIN
    delivered_order d USING (seller_id)
GROUP BY s.seller_state;

-- 2. For each product category, calculate the cumulative revenue generated as orders come in over time
create temporary table  payments
select oi.product_id,oi.price,o.order_purchase_timestamp from order_items oi join orders o using(order_id);
SELECT
    COALESCE(po.product_category_name, 'Unknown') AS category,
    p.price,
    p.order_purchase_timestamp,
    round(sum(p.price) OVER(
        PARTITION BY po.product_category_name
        ORDER BY p.order_purchase_timestamp
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ),2 )AS cumulative_revenue
FROM payments p
JOIN products po USING(product_id)
ORDER BY category, p.order_purchase_timestamp;

-- 3. Which payment method do customers use the most, and what is the average order value for each payment type?
    
SELECT 
    COALESCE(op.payment_type, 'unknown') payment_type,
    COUNT(oi.order_id) total_orders,
    ROUND(AVG(oi.price)) avg_value
FROM
    order_payments op
        RIGHT JOIN
    order_items oi USING (order_id)
GROUP BY payment_type;
 
 
 -- 4. Find the customer who has spent the most money across all their orders.
 
create temporary table custom_id
SELECT 
    c.customer_unique_id, o.order_id
FROM
    customers c
        JOIN
    orders o USING (customer_id);
SELECT 
	ci.customer_unique_id,
    COUNT(oi.order_id) total_orders,
    SUM(oi.price) total_money
   
FROM
    order_items oi
        JOIN
    custom_id ci USING (order_id)
GROUP BY (ci.customer_unique_id)
ORDER BY (total_money) DESC;

-- 5.  Find the average review score for each product category.
create temporary table prod_name
select oi.order_id,p.product_category_name from order_items oi join products p using(product_id);
SELECT 
    COALESCE(pn.product_category_name, 'Unknown') AS category,
    AVG(r.review_score) avg_review_score
FROM
    prod_name pn
        JOIN
    order_reviews r USING (order_id)
GROUP BY (pn.product_category_name);


--  6. Find the total number of orders placed by each customer, broken down by the state they live in.
create temporary table custom_orders
SELECT 
    c.customer_unique_id, o.order_id, c.customer_state
FROM
    customers c
        JOIN
    orders o USING (customer_id);
SELECT 
    *
FROM
    custom_orders;
SELECT
    customer_unique_id,
    customer_state,
    COUNT(DISTINCT order_id) AS total_orders
FROM custom_orders
GROUP BY
    customer_unique_id,
    customer_state
ORDER BY
    customer_state,
    total_orders DESC;
    
