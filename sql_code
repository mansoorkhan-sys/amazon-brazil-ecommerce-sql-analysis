-- 13. Identify customers who have placed orders but never left a review. 
create temporary table null_review
 select o.order_id, c.customer_unique_id from orders o join customers c using(customer_id);
SELECT 
    nr.customer_unique_id
FROM
    null_review nr
        LEFT JOIN
    order_reviews r USING (order_id)
WHERE
    r.review_comment_message IS NULL;
    
    
-- 14.Find the month with the highest number of orders placed across the entire platform.
SELECT 
    MONTHNAME(order_purchase_timestamp) months,
    COUNT(order_id) total_orders
FROM
    orders
GROUP BY months
ORDER BY total_orders DESC;
 
